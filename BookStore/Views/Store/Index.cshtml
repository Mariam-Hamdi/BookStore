@model IEnumerable<BookStore.Models.Book>
@{
    ViewData["Title"] = "Store";
}
<h2 class="my-4">Store</h2>
<form asp-action="Index" class="col-2 my-1 p-2">
    <div>
        <h5>Filter search</h5> <!-- عنوان الفلتر -->
        <div class="my-1">
            <input type="text" name="searchString" placeholder="Title or Author" class="form-control-sm col-18" />
        </div>
        <div class="my-1">
            <input type="number" name="minPrice" step="1" placeholder="$min" class="form-control-sm col-5"  />
            &nbsp;&#8212;&nbsp;
            <input type="number" name="maxPrice" step="1" placeholder="$max" class="form-control-sm col-5" />
        </div>
        <div class="my-2">
            <input type="submit" value="Filter" class="btn btn-primary btn-sm " />
            <a asp-action="Index" class="btn btn-secondary btn-sm float-right  ">Clear</a>
        </div>
    </div>
</form>




<div class="row">
    @foreach (var book in Model)
    {
        <div class="col-3">
            <div class="mb-4">
            <div class="card" my-2 store-card">
                <a class="a-cleanup" asp-controller="Store" asp-action="Details" asp-route-id="@book.Id">
                    <img src="@book.ImageUrl" class="card-img-top card-img-custom">
                    <div class="card-body" style="height: 6em;">
                        <h5 class="mb-3">@book.Title</h5>
                    </div>
                    <div class="card-Fav">
                        <span class="card-text">@book.Price.ToString("c")</span>
                        <a asp-controller="Cart" asp-action="AddtoCart" asp-route-id="@book.Id" class="btn btn-primary float-right store-btn"><i class="fa-solid fa-cart-plus"></i></a>
                        <form asp-controller="Favorites" asp-action="AddToFavorites" method="post">
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                        </form>


                    </div>
                </a>
            </div>
            </div>
        </div>
    }
</div>